<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SmooAI.SmoothOperator.Core.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Microsoft.Extensions.AI (not just Abstractions) for AIFunctionFactory.Create —
         authoring tools from ordinary C# methods, exactly as a MAF/SK dev does. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.7.1" />
    <!-- Live eval harness (gated): an OpenAI-compatible IChatClient against the gateway,
         plus SkippableFact so the suite skips cleanly without SMOOTH_AGENT_E2E + key. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="9.7.1-preview.1.25365.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\SmooAI.SmoothOperator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SEP conformance fixtures (vendored copy of spec/extension/conformance/fixtures.json) + the
         Node echo peer for the live extension-host tests. Copied next to the test assembly so the
         tests locate them regardless of the working directory. -->
    <None Include="sep\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- THE shared eval corpus. Not vendored: this is a build-time copy of the single
         source of truth at spec/evals/scenarios.json, linked into the output so the
         tests locate it regardless of working directory. Editing the copy is pointless
         — it is overwritten from spec/ on every build. -->
    <None Include="..\..\..\spec\evals\scenarios.json" Link="evals\scenarios.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- THE shared Narc detection corpus. Same deal as the eval corpus: a build-time copy
         of the single source of truth at spec/narc/corpus.json, so the .NET secret /
         prompt-injection detectors are pinned to the same vectors as the other four
         engines and cannot drift weaker unnoticed. -->
    <None Include="..\..\..\spec\narc\corpus.json" Link="narc\corpus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
